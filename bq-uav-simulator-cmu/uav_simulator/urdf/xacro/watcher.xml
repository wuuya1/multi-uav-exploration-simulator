<?xml version="1.0"?>

<robot name="watcher" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- <link name="world"/>

  <joint name="watcher_joint" type="fixed">
    <parent link="world"/>
    <child link="watcher_link"/>
  </joint> -->

  <link name="watcher_link">
    <collision>
      <origin xyz="0 0 0.1" rpy="0 0 0"/>
      <geometry>
        <box size="0.2 0.2 0.2"/>
      </geometry>
    </collision>

    <visual>
      <origin xyz="0 0 20" rpy="0 0 0"/>
      <geometry>
        <box size="0.2 0.2 0.2"/>
      </geometry>
      <material name="orange"/>
    </visual>

    <inertial>
      <origin xyz="0 0 1" rpy="0 0 0"/>
      <mass value="1"/>
      <inertia
        ixx="1.0" ixy="0.0" ixz="0.0"
        iyy="1.0" iyz="0.0"
        izz="1.0"/>
    </inertial>
  </link>

  <material name="orange">
    <color rgba="${255/255} ${108/255} ${10/255} 1.0"/>
  </material>
  <gazebo reference="watcher_link">
    <material>Gazebo/Orange</material>
  </gazebo>

</robot>